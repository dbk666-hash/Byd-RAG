# 默认Qwen生成、bge-m3向量和BGE重排共用此密钥。
SILICONFLOW_API_KEY=

# siliconflow / deepseek / glm；只需要所选生成厂商的密钥。
RAG_CHAT_PROVIDER=siliconflow
# DeepSeek_API_KEY=
# GLM_API_KEY=

# 默认跳过Requests自动代理；不表示绕过系统TUN。
RAG_TRUST_ENV=false

# 可选：覆盖所选厂商的默认模型/URL；须保证密钥与接口匹配。
# RAG_CHAT_MODEL=Qwen/Qwen3.5-4B
# RAG_CHAT_URL=https://api.siliconflow.cn/v1/chat/completions

# 可选：另建实验索引时使用独立路径，避免混用不同切块/向量模型。
# RAG_PARSED_DIR=D:/your-data/parsed
# RAG_DB_PATH=D:/your-data/chroma-experiment
